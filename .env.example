# ── API Server ────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# MySQL — required for portfolio, watchlist, settings, and user accounts.
# Either a single connection string…
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DBNAME

# …or discrete credentials, which is what Hostinger's MySQL panel gives you.
# (Used only when DATABASE_URL is unset. If your password contains reserved URL
# characters (e.g. # @ / :), prefer these over the URL form.)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=
# DB_PASSWORD=
# DB_NAME=

# Signs session cookies (JWT). Use a long random string in production,
# e.g. `openssl rand -hex 32`.
JWT_SECRET=change-this-to-a-long-random-string

# Initial admin account — auto-created on first boot if no admin exists yet
# (along with the default roles, on a brand new database).
# Change the password (or these values) before deploying to production.
ADMIN_EMAIL=team@marketpulse.learninhome.com
ADMIN_PASSWORD=Admin@123

# Public base URL, used to build password-reset/email-verification links.
# Falls back to the request host if unset. Set this in production:
# APP_BASE_URL=https://marketpulse.learninhome.com

# SMTP fallback — only used when no SMTP settings have been saved yet via
# Admin -> Email / SMTP (that admin-configured, DB-stored config always takes
# precedence once it exists; these vars just cover first boot / local dev).
# Until either source is configured, emails are only logged on the server.
# Set SHOW_RESET_LINK=true to also return the reset link in the API response
# for testing (leave OFF in production once email works).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@marketpulse.learninhome.com
# SHOW_RESET_LINK=false

# Optional: Upstox API (users configure this from the Settings page)
# UPSTOX_API_KEY=
# UPSTOX_API_SECRET=
